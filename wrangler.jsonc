{
  // The "greece" Worker serves public/index.html at greece.johnshawler.com.
  "name": "greece",
  "main": "src/index.js",
  "compatibility_date": "2026-11-18",
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "routes": [{ "pattern": "greece.johnshawler.com", "custom_domain": true }]
}
